  <rect x="790" y="190" width="160" height="60" rx="4" fill="#FFFFFF" stroke="#12161A" stroke-width="1.25"/>
  <rect x="790" y="194" width="3" height="52" fill="#63489E"/>
  <text x="870" y="225" fill="#12161A" text-anchor="middle" font-size="15" font-weight="600">Six</text>
