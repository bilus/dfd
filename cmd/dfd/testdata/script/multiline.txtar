dfd flow.dfd -o flow.svg
cmp flow.svg want.svg

-- flow.dfd --
[This is a box
 line 2]
> line 1
  line 2
[Middle box]
    > aaa
      bbb
    < ccc
      ddd
    |Store|
[Another box]
-- want.svg --
<svg viewBox="0 0 740 240" width="740" height="240" xmlns="http://www.w3.org/2000/svg" font-family="Helvetica, Arial, sans-serif" font-size="13">
