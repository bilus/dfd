  <line x1="200" y1="170" x2="287" y2="170" stroke="#000" stroke-width="1.5" marker-end="url(#ah)"/>
  <text x="245" y="145" fill="#000" text-anchor="middle">line 1</text>
  <text x="245" y="162" fill="#000" text-anchor="middle">line 2</text>
  <line x1="295" y1="40" x2="445" y2="40" stroke="#000" stroke-width="2"/>
  <line x1="295" y1="76" x2="445" y2="76" stroke="#000" stroke-width="2"/>
  <text x="370" y="62" fill="#000" text-anchor="middle">Store</text>
  <line x1="350" y1="140" x2="350" y2="79" stroke="#000" stroke-width="1.5" marker-end="url(#ah)"/>
  <text x="342" y="105" fill="#000" text-anchor="end">aaa</text>
  <text x="342" y="122" fill="#000" text-anchor="end">bbb</text>
  <line x1="390" y1="76" x2="390" y2="137" stroke="#000" stroke-width="1.5" marker-end="url(#ah)"/>
  <text x="398" y="105" fill="#000">ccc</text>
