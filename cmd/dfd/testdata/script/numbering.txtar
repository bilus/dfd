# --number numbers processes in flow order and datastores D1, D2,
# skipping external entities. Off unless asked for.
dfd --number flow.dfd -o plain.svg
cmp plain.svg want-plain.svg

dfd --number --theme plex flow.dfd -o plex.svg
cmp plex.svg want-plex.svg

# a levelled diagram numbers 2.1, 2.2
dfd --number --number-prefix 2. flow.dfd -o levelled.svg
grep '>2\.1<' levelled.svg
grep '>2\.2<' levelled.svg

# numbering must survive rasterization too
dfd --number flow.dfd -o numbered.png
exists numbered.png

# without the flag nothing is numbered
dfd flow.dfd -o bare.svg
! grep '>1<' bare.svg
! grep 'D1 ' bare.svg

-- flow.dfd --
{Client}
> request
[Authenticate]
    > lookup
    < profile
    |Users|
> claims
[Render page]
    > page
    |Pages|
> html
{CDN}
