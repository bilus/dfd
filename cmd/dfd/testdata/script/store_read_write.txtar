dfd flow.dfd -o flow.svg
cmp flow.svg want.svg

-- flow.dfd --
[Initial step]
> input
[Store in database]
    > input
    < record id
    |Somethings|
> record id
[Return to user]
-- want.svg --
<svg viewBox="0 0 740 240" width="740" height="240" xmlns="http://www.w3.org/2000/svg" font-family="Helvetica, Arial, sans-serif" font-size="13">
  <defs>
    <marker id="ah" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
      <path d="M0,0L10,5L0,10z" fill="#000"/>
    </marker>
  </defs>
  <rect x="0" y="0" width="740" height="240" fill="#fff"/>
  <rect x="40" y="140" width="160" height="60" fill="#fff" stroke="#000" stroke-width="2"/>
  <text x="120" y="175" fill="#000" text-anchor="middle">Initial step</text>
  <rect x="290" y="140" width="160" height="60" fill="#fff" stroke="#000" stroke-width="2"/>
  <text x="370" y="175" fill="#000" text-anchor="middle">Store in database</text>
  <line x1="200" y1="170" x2="287" y2="170" stroke="#000" stroke-width="1.5" marker-end="url(#ah)"/>
  <text x="245" y="162" fill="#000" text-anchor="middle">input</text>
  <line x1="295" y1="40" x2="445" y2="40" stroke="#000" stroke-width="2"/>
  <line x1="295" y1="76" x2="445" y2="76" stroke="#000" stroke-width="2"/>
  <text x="370" y="62" fill="#000" text-anchor="middle">Somethings</text>
  <line x1="350" y1="140" x2="350" y2="79" stroke="#000" stroke-width="1.5" marker-end="url(#ah)"/>
  <text x="342" y="113" fill="#000" text-anchor="end">input</text>
  <line x1="390" y1="76" x2="390" y2="137" stroke="#000" stroke-width="1.5" marker-end="url(#ah)"/>
  <text x="398" y="113" fill="#000">record id</text>
  <rect x="540" y="140" width="160" height="60" fill="#fff" stroke="#000" stroke-width="2"/>
  <text x="620" y="175" fill="#000" text-anchor="middle">Return to user</text>
  <line x1="450" y1="170" x2="537" y2="170" stroke="#000" stroke-width="1.5" marker-end="url(#ah)"/>
  <text x="495" y="162" fill="#000" text-anchor="middle">record id</text>
</svg>
