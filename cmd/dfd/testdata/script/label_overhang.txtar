# A store label in the last column overhangs its grid column; the canvas
# grows to keep it, with equal margins either side.
dfd --theme plex flow.dfd -o plex.svg
cmp plex.svg want-plex.svg

dfd flow.dfd -o plain.svg
cmp plain.svg want-plain.svg

-- flow.dfd --
[Start]
> go
[Register live page
 for join]
    > page id, mountFn, tree
    |Registry|
-- want-plex.svg --
<svg viewBox="0 0 585 244" width="585" height="244" xmlns="http://www.w3.org/2000/svg" font-family="IBM Plex Sans, Helvetica Neue, Arial, sans-serif" font-size="13">
  <defs>
    <marker id="ah" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
      <path d="M0,0L10,5L0,10z" fill="#63489E"/>
    </marker>
  </defs>
  <rect x="0" y="0" width="585" height="244" fill="#F2F4F6"/>
  <rect x="40" y="140" width="160" height="64" rx="4" fill="#FFFFFF" stroke="#12161A" stroke-width="1.25"/>
  <rect x="40" y="144" width="3" height="56" fill="#63489E"/>
  <text x="120" y="177" fill="#12161A" text-anchor="middle" font-size="15" font-weight="600">Start</text>
  <rect x="290" y="140" width="160" height="64" rx="4" fill="#FFFFFF" stroke="#12161A" stroke-width="1.25"/>
  <rect x="290" y="144" width="3" height="56" fill="#63489E"/>
  <text x="370" y="167" fill="#12161A" text-anchor="middle" font-size="15" font-weight="600">Register live page</text>
  <text x="370" y="187" fill="#12161A" text-anchor="middle" font-size="15" font-weight="600">for join</text>
  <line x1="200" y1="172" x2="287" y2="172" stroke="#63489E" stroke-width="1.4" marker-end="url(#ah)"/>
  <rect x="230" y="160" width="31" height="24" rx="3" fill="#F2F4F6"/>
  <text x="245" y="176" fill="#63489E" text-anchor="middle" font-family="IBM Plex Mono, SF Mono, Menlo, monospace" font-size="12">go</text>
  <line x1="295" y1="40" x2="445" y2="40" stroke="#12161A" stroke-width="1.25"/>
  <line x1="295" y1="76" x2="445" y2="76" stroke="#12161A" stroke-width="1.25"/>
  <text x="370" y="63" fill="#12161A" text-anchor="middle" font-size="15" font-weight="600">Registry</text>
  <line x1="370" y1="140" x2="370" y2="79" stroke="#63489E" stroke-width="1.4" marker-end="url(#ah)"/>
  <rect x="370" y="97" width="175" height="24" rx="3" fill="#F2F4F6"/>
  <text x="378" y="113" fill="#63489E" font-family="IBM Plex Mono, SF Mono, Menlo, monospace" font-size="12">page id, mountFn, tree</text>
</svg>
-- want-plain.svg --
<svg viewBox="0 0 551 240" width="551" height="240" xmlns="http://www.w3.org/2000/svg" font-family="Helvetica, Arial, sans-serif" font-size="13">
  <defs>
    <marker id="ah" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
      <path d="M0,0L10,5L0,10z" fill="#000"/>
    </marker>
  </defs>
  <rect x="0" y="0" width="551" height="240" fill="#fff"/>
  <rect x="40" y="140" width="160" height="60" fill="#fff" stroke="#000" stroke-width="2"/>
  <text x="120" y="175" fill="#000" text-anchor="middle">Start</text>
  <rect x="290" y="140" width="160" height="60" fill="#fff" stroke="#000" stroke-width="2"/>
  <text x="370" y="167" fill="#000" text-anchor="middle">Register live page</text>
  <text x="370" y="184" fill="#000" text-anchor="middle">for join</text>
  <line x1="200" y1="170" x2="287" y2="170" stroke="#000" stroke-width="1.5" marker-end="url(#ah)"/>
  <text x="245" y="162" fill="#000" text-anchor="middle">go</text>
  <line x1="295" y1="40" x2="445" y2="40" stroke="#000" stroke-width="2"/>
  <line x1="295" y1="76" x2="445" y2="76" stroke="#000" stroke-width="2"/>
  <text x="370" y="62" fill="#000" text-anchor="middle">Registry</text>
  <line x1="370" y1="140" x2="370" y2="79" stroke="#000" stroke-width="1.5" marker-end="url(#ah)"/>
  <text x="378" y="113" fill="#000">page id, mountFn, tree</text>
</svg>
