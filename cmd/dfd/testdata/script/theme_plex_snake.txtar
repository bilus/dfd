  <line x1="45" y1="314" x2="195" y2="314" stroke="#12161A" stroke-width="1.25"/>
  <line x1="45" y1="350" x2="195" y2="350" stroke="#12161A" stroke-width="1.25"/>
  <text x="120" y="337" fill="#12161A" text-anchor="middle" font-size="15" font-weight="600">Disk</text>
