  <rect x="290" y="190" width="160" height="60" rx="4" fill="#FFFFFF" stroke="#12161A" stroke-width="1.25"/>
  <rect x="290" y="194" width="3" height="52" fill="#63489E"/>
  <text x="370" y="225" fill="#12161A" text-anchor="middle" font-size="15" font-weight="600">Three</text>
  <line x1="370" y1="100" x2="370" y2="187" stroke="#63489E" stroke-width="1.4" marker-end="url(#ah)"/>
  <rect x="348" y="137" width="45" height="16" rx="3" fill="#F2F4F6"/>
  <text x="370" y="149" fill="#63489E" text-anchor="middle" font-family="IBM Plex Mono, SF Mono, Menlo, monospace" font-size="12">down</text>
