# Turn labels and a below-row datastore, in the plex theme.
dfd --theme plex --per-row 2 flow.dfd -o flow.svg
cmp flow.svg want.svg

-- flow.dfd --
[One]
[Two]
> down
[Three]
[Four]
    > save
    < load
    |Disk|
-- want.svg --
<svg viewBox="0 0 490 390" width="490" height="390" xmlns="http://www.w3.org/2000/svg" font-family="IBM Plex Sans, Helvetica Neue, Arial, sans-serif" font-size="13">
  <defs>
    <marker id="ah" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
