dfd flow.dfd -o flow.svg
cmp flow.svg want.svg

-- flow.dfd --
# The original whiteboard example, in dfd syntax.
[Start process]
> foo
[Continue running]
> foo
[Change something that doesn't work]
    > data
    < result
    |Somethnigs|
> foo bar
[Blah blah]
> decision
[Revert]
> something
[Store data in database]
    > something
    |Database|
> thing2
[Finish]
-- want.svg --
<svg viewBox="0 0 990 490" width="990" height="490" xmlns="http://www.w3.org/2000/svg" font-family="Helvetica, Arial, sans-serif" font-size="13">
  <defs>
    <marker id="ah" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
      <path d="M0,0L10,5L0,10z" fill="#000"/>
    </marker>
  </defs>
  <rect x="0" y="0" width="990" height="490" fill="#fff"/>
  <rect x="40" y="140" width="160" height="60" fill="#fff" stroke="#000" stroke-width="2"/>
  <text x="120" y="175" fill="#000" text-anchor="middle">Start process</text>
  <rect x="290" y="140" width="160" height="60" fill="#fff" stroke="#000" stroke-width="2"/>
  <text x="370" y="175" fill="#000" text-anchor="middle">Continue running</text>
  <line x1="200" y1="170" x2="287" y2="170" stroke="#000" stroke-width="1.5" marker-end="url(#ah)"/>
  <text x="245" y="162" fill="#000" text-anchor="middle">foo</text>
  <rect x="540" y="140" width="160" height="60" fill="#fff" stroke="#000" stroke-width="2"/>
  <text x="620" y="167" fill="#000" text-anchor="middle">Change something that</text>
  <text x="620" y="184" fill="#000" text-anchor="middle">doesn't work</text>
  <line x1="450" y1="170" x2="537" y2="170" stroke="#000" stroke-width="1.5" marker-end="url(#ah)"/>
  <text x="495" y="162" fill="#000" text-anchor="middle">foo</text>
  <line x1="545" y1="40" x2="695" y2="40" stroke="#000" stroke-width="2"/>
  <line x1="545" y1="76" x2="695" y2="76" stroke="#000" stroke-width="2"/>
  <text x="620" y="62" fill="#000" text-anchor="middle">Somethnigs</text>
  <line x1="600" y1="140" x2="600" y2="79" stroke="#000" stroke-width="1.5" marker-end="url(#ah)"/>
  <text x="592" y="113" fill="#000" text-anchor="end">data</text>
  <line x1="640" y1="76" x2="640" y2="137" stroke="#000" stroke-width="1.5" marker-end="url(#ah)"/>
  <text x="648" y="113" fill="#000">result</text>
  <rect x="790" y="140" width="160" height="60" fill="#fff" stroke="#000" stroke-width="2"/>
  <text x="870" y="175" fill="#000" text-anchor="middle">Blah blah</text>
  <line x1="700" y1="170" x2="787" y2="170" stroke="#000" stroke-width="1.5" marker-end="url(#ah)"/>
  <text x="745" y="162" fill="#000" text-anchor="middle">foo bar</text>
  <rect x="790" y="290" width="160" height="60" fill="#fff" stroke="#000" stroke-width="2"/>
  <text x="870" y="325" fill="#000" text-anchor="middle">Revert</text>
  <line x1="870" y1="200" x2="870" y2="287" stroke="#000" stroke-width="1.5" marker-end="url(#ah)"/>
  <text x="878" y="250" fill="#000">decision</text>
  <rect x="540" y="290" width="160" height="60" fill="#fff" stroke="#000" stroke-width="2"/>
  <text x="620" y="325" fill="#000" text-anchor="middle">Store data in database</text>
  <line x1="790" y1="320" x2="703" y2="320" stroke="#000" stroke-width="1.5" marker-end="url(#ah)"/>
  <text x="745" y="312" fill="#000" text-anchor="middle">something</text>
  <line x1="545" y1="414" x2="695" y2="414" stroke="#000" stroke-width="2"/>
  <line x1="545" y1="450" x2="695" y2="450" stroke="#000" stroke-width="2"/>
  <text x="620" y="436" fill="#000" text-anchor="middle">Database</text>
  <line x1="620" y1="350" x2="620" y2="411" stroke="#000" stroke-width="1.5" marker-end="url(#ah)"/>
  <text x="628" y="387" fill="#000">something</text>
  <rect x="290" y="290" width="160" height="60" fill="#fff" stroke="#000" stroke-width="2"/>
  <text x="370" y="325" fill="#000" text-anchor="middle">Finish</text>
  <line x1="540" y1="320" x2="453" y2="320" stroke="#000" stroke-width="1.5" marker-end="url(#ah)"/>
  <text x="495" y="312" fill="#000" text-anchor="middle">thing2</text>
</svg>
